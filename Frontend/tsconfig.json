{
  "compilerOptions": {
    "jsx": "react-jsx",            // ✅ React 17+ JSX transform
    "moduleResolution": "node",    // helps TS find node_modules
    "module": "ESNext",
    "target": "ES2020",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true           // optional but avoids noise
  }
}
